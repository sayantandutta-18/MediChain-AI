# ---------------------------------------------------------------------------
# MediChain-AI :: backend environment configuration
# Copy to `.env` and fill in. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database -------------------------------------------------------------
# Local dev:  mongodb://127.0.0.1:27017/medichain
# Production: mongodb+srv://<user>:<pass>@<cluster>/medichain?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/medichain

# --- Auth -----------------------------------------------------------------
# openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-development-only-secret-value
JWT_EXPIRES_IN=2h
JWT_ISSUER=medichain-ai
JWT_AUDIENCE=medichain-ai-clients
BCRYPT_SALT_ROUNDS=10

# --- Encryption (TRD-6) ---------------------------------------------------
# 32-byte key as 64 hex characters:  openssl rand -hex 32
# If left empty, ENCRYPTION_PASSPHRASE is used to derive a key (scrypt).
ENCRYPTION_KEY=
ENCRYPTION_PASSPHRASE=change-me-encryption-passphrase
ENCRYPTION_KEY_VERSION=v1

# --- Uploads (TRD-12) -----------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/json,text/csv

# --- CORS / security ------------------------------------------------------
# Comma separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Sui testnet blockchain (TRD-8) ---------------------------------------
SUI_NETWORK=testnet
# Published Move package id (see sui/README.md)
SUI_PACKAGE_ID=
# Object id of the shared MedicalRecordRegistry created after publishing
SUI_REGISTRY_ID=
# Used only to read on-chain state. Write keys are supplied at runtime only.
SUI_ENV_MNEMONIC=
SUI_EDITOR_MODE=false

# --- AI service (TRD-15) --------------------------------------------------
# Server side only. If empty the AI endpoints return a controlled 503.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000
