# ---------------------------------------------------------------------------
# Docker Compose runtime configuration.
# Copy to `.env` in the repository root and fill in. NEVER commit the real file.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32  (must be exactly 64 hex characters)
ENCRYPTION_KEY=

# --- Optional --------------------------------------------------------------
NODE_ENV=production
JWT_EXPIRES_IN=2h
ENCRYPTION_KEY_VERSION=v1

# Comma separated. Use your exact frontend origin in production.
CORS_ORIGIN=http://localhost:8080

# Leave empty for the bundled MongoDB service, or paste a MongoDB Atlas URI.
MONGODB_URI=mongodb://mongodb:27017/medichain

MAX_FILE_SIZE_MB=10

# --- Sui testnet anchoring (see sui/README.md) ------------------------------
# Leave empty to run with simulated anchors.
SUI_NETWORK=testnet
SUI_PACKAGE_ID=
SUI_REGISTRY_ID=
SUI_ENV_MNEMONIC=

# --- AI assistant ----------------------------------------------------------
# Leave empty to disable the AI endpoints (they return a controlled 503).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Build-time value baked into the frontend bundle. Keep it relative (/api/v1)
# so the browser stays same-origin behind the nginx proxy.
VITE_API_URL=/api/v1
